{
  "info": {
    "_postman_id": "be0a8c35-3a6b-4f17-a69f-aad6f91427c3",
    "name": "Leave API",
    "description": "Login and complete leave CRUD flow: create, get by id, update status, filter, and delete.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "applicant",
      "value": "alice"
    },
    {
      "key": "leaveId",
      "value": "1"
    },
    {
      "key": "status",
      "value": "APPROVED"
    },
    {
      "key": "username",
      "value": "admin"
    },
    {
      "key": "password",
      "value": "1234"
    }
  ],
  "item": [
    {
      "name": "1. POST - Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "login"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('練習帳密登入成功', function () {",
              "  pm.response.to.have.status(200);",
              "  const body = pm.response.json();",
              "  pm.expect(body.code).to.eql(null);",
              "  pm.expect(body.data.success).to.eql(true);",
              "});"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "2. POST - Create Leave",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"applicant\": \"{{applicant}}\",\n  \"leaveType\": \"annual\",\n  \"startDate\": \"2026-09-28\",\n  \"endDate\": \"2026-09-29\",\n  \"reason\": \"vacation\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/leaves",
          "host": ["{{baseUrl}}"],
          "path": ["api", "leaves"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('建立成功並回傳待審狀態', function () {",
              "  pm.response.to.have.status(200);",
              "  const body = pm.response.json();",
              "  pm.expect(body.code).to.eql(null);",
              "  pm.expect(body.data.status).to.eql('PENDING');",
              "  pm.collectionVariables.set('leaveId', body.data.id);",
              "});"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "3. GET - Get Leave by ID",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/leaves/{{leaveId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "leaves", "{{leaveId}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('可依建立後的 ID 查詢', function () {",
              "  pm.response.to.have.status(200);",
              "  const body = pm.response.json();",
              "  pm.expect(body.code).to.eql(null);",
              "  pm.expect(body.data.id).to.eql(Number(pm.collectionVariables.get('leaveId')));",
              "});"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "4. PUT - Update Status",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"APPROVED\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/leaves/{{leaveId}}/status",
          "host": ["{{baseUrl}}"],
          "path": ["api", "leaves", "{{leaveId}}", "status"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('狀態更新為核准', function () {",
              "  pm.response.to.have.status(200);",
              "  const body = pm.response.json();",
              "  pm.expect(body.code).to.eql(null);",
              "  pm.expect(body.data.status).to.eql('APPROVED');",
              "});"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "5. GET - Filter by Status",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/leaves?status={{status}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "leaves"],
          "query": [
            {
              "key": "status",
              "value": "{{status}}"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('狀態篩選只回傳指定狀態', function () {",
              "  pm.response.to.have.status(200);",
              "  const body = pm.response.json();",
              "  pm.expect(body.code).to.eql(null);",
              "  pm.expect(body.data).to.be.an('array');",
              "  pm.expect(body.data.length).to.be.above(0);",
              "  body.data.forEach(item => pm.expect(item.status).to.eql(pm.collectionVariables.get('status')));",
              "});"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "6. DELETE - Delete Leave",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/leaves/{{leaveId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "leaves", "{{leaveId}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('刪除成功', function () {",
              "  pm.response.to.have.status(200);",
              "  const body = pm.response.json();",
              "  pm.expect(body.data).to.eql(null);",
              "  pm.expect(body.code).to.eql(null);",
              "});"
            ]
          }
        }
      ],
      "response": []
    }
  ]
}
